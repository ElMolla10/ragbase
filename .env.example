# Backend only. Provider keys stay in the OpenRouter workspace BYOK settings.
OPENROUTER_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
USE_HYBRID_SEARCH=true
# Approximate token units (four characters per unit).
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# Railway: reference the Postgres service's DATABASE_URL directly.
DATABASE_URL=postgresql+asyncpg://ragbase:ragbase@localhost:5432/ragbase
# Frontend only (Compose overrides this with http://backend:8000).
BACKEND_URL=http://localhost:8000
# Local Docker Compose database settings.
POSTGRES_USER=ragbase
POSTGRES_PASSWORD=ragbase
POSTGRES_DB=ragbase

# Demo limits (0 disables an endpoint rate limit).
MAX_UPLOAD_BYTES=50000000
QUERY_RATE_LIMIT=30
INGEST_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60
PDF_LAYOUT_EXTRACTION=true
# Optional: protects ingest/delete via X-API-Key; queries remain public.
WRITE_API_KEY=
